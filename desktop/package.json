{
  "name": "proalgo-live",
  "productName": "Pro Algorithm Live",
  "version": "1.1.0",
  "description": "Listens to sales calls and builds the work plan live",
  "author": "Pro Algorithm",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.proalgorithm.live",
    "productName": "Pro Algorithm Live",
    "artifactName": "ProAlgorithmLive-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "micmonitor.js",
      "config.defaults.json",
      "config.build.json",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Pro Algorithm Live"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
