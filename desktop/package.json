{
  "name": "proalgo-live",
  "productName": "Pro Algorithm Live",
  "version": "1.2.0",
  "description": "Listens to sales calls and builds the work plan live",
  "author": "Pro Algorithm",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.proalgorithm.live",
    "productName": "Pro Algorithm Live",
    "artifactName": "ProAlgorithmLive-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "micmonitor.js",
      "micwatch.ps1",
      "updater.js",
      "config.defaults.json",
      "config.build.json",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Pro Algorithm Live"
    },
    "publish": {
      "provider": "github",
      "owner": "fleet-360",
      "repo": "proalgo-live",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
