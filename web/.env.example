# --- חובה ---
# סיסמה משותפת בין אפליקציית המחשב לשרת. כל מחרוזת ארוכה ואקראית.
APP_TOKEN=change-me-to-a-long-random-string

# מפתח Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# ספק תמלול: openai, elevenlabs או gemini
STT_PROVIDER=openai
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# --- אחסון (ב-Vercel: Storage > Upstash for Redis, המשתנים נוספים לבד) ---
# בלי אחסון השרת שומר בזיכרון, וזה מתאים רק להרצה מקומית.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- רשות ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# OPENAI_STT_MODEL=gpt-4o-transcribe
# ELEVENLABS_STT_MODEL=scribe_v1
# GEMINI_STT_MODEL=gemini-3.5-transcribe
